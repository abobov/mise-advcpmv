#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute advcpmv"
set -euo pipefail

mise plugin link --force advcpmv .
mise cache clear
mise install advcpmv@1.0-9.12

# Capture and display advcp version output
output=$(mise exec "advcpmv@1.0-9.12" -- advcp --version)
echo "advcp output: $output"

if echo "$output" | grep -q 'advcpmv'; then
    echo "✓ advcp test passed"
else
    echo "✗ Test failed: expected advcpmv in advcp --version output"
    exit 1
fi

# Verify advmv is also installed
output_mv=$(mise exec "advcpmv@1.0-9.12" -- advmv --version)
echo "advmv output: $output_mv"

if echo "$output_mv" | grep -q 'advcpmv'; then
    echo "✓ advmv test passed"
else
    echo "✗ Test failed: expected advcpmv in advmv --version output"
    exit 1
fi

echo "✓ All tests passed"
